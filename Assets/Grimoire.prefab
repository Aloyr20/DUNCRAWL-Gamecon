  potionSlotPrefab: {fileID: 2242779106334818007, guid: dde8b6c8cf4980546bf2fa4b84a8ace9, type: 3}
  spellPages:
  - spellID: Ice
    spellName: Ice Spell
    description: 'A powerful element to be harnessed by the magically attuned.

      This
      spell casts a freezing flurry that explodes upon contact with any obstacle
      in its path.


      -Freezes afflicted creatures, slowing them down

      -Extinguishes
      burning creatures

      -Freezes up any toxins within the bodies of afflicted
      creatures

'
    spellSprite: {fileID: 1613871845, guid: ee717cc38342bbc44a7391d171904fe0, type: 3}
  - spellID: Poison
    spellName: Poison Spell
    description: 'A powerful element to be harnessed by the magically attuned.

      This
      spell casts a toxic blast that explodes upon contact with any obstacle in its
      path.


      -Poisons afflicted creatures

      -Deals extra damage to singed
      creatures

      -Toxins spread faster through frigid bodies

'
    spellSprite: {fileID: -53465938, guid: 1c66a5358c5b6bb49955ed28192dfcda, type: 3}
  - spellID: Fire
    spellName: Fire Spell
    description: 'A powerful element to be harnessed by the magically attuned.

      This
      spell casts a large fireball that explodes upon contact with any obstacle in
      its path.


      -Leaves afflicted creatures burning

      -Will thaw frozen
      creatures

      -Will burn up any toxins within the bodies of afflicted creatures

'
    spellSprite: {fileID: 1634123405, guid: 45102f9c09326a84e9674dbd59afbb27, type: 3}
  allPotions:
  - potionID: Health
    potionName: Health Potion
    potionDescription: 'A special mixture with healing properties.

      -Restores
      a minor amount of health

'
    potionSprite: {fileID: -1331519450, guid: 4bc55881e93ccec4fb843eff8e702bd6, type: 3}
  - potionID: Mana
    potionName: Mana Potion
    potionDescription: 'A special mixture containing pure magic.

      -Restores
      a minor amount of mana

'
    potionSprite: {fileID: -304632549, guid: 619c5246c649be647b7acc5b99263718, type: 3}
  - potionID: Speed
    potionName: Speed Potion
    potionDescription: 'A special mixture constantly moving within its bottle.

      -Temporarily
      boosts the users speed

'
    potionSprite: {fileID: 337749657, guid: 3cffda6bfe1d8eb47bbf8943ebceea69, type: 3}
